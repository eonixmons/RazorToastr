<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- clear discards any feed inherited from the machine-wide configuration, so a clone of
         this repository restores identically on a developer machine and on a CI runner. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
